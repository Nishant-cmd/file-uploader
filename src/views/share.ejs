<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shared: <%= root.name %></title><link rel="stylesheet" href="/css/base.css"><link rel="stylesheet" href="/css/drive.css"><link rel="stylesheet" href="/css/share.css"></head><body><main class="container"><h1>📁 <%= root.name %></h1><p class="muted">Shared folder · expires <%= expiresAt.toLocaleString() %></p><ul class="items"><% folders.forEach(function(folder) { %><li class="shared-entry indent-<%= Math.min(folder.depth + 1, 8) %>">📁 <%= folder.name %></li><% }); %><% files.forEach(function(file) { %><li class="shared-entry indent-<%= Math.min(file.depth + 1, 8) %>">📄 <a href="/share/<%= shareId %>/file/<%= file.id %>"><%= file.name %></a> · <%= (file.size / 1024).toFixed(1) %> KB</li><% }); %></ul><p>Files are available to anyone with this link.</p></main></body></html>
