<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= file.name %></title><link rel="stylesheet" href="/css/base.css"><link rel="stylesheet" href="/css/drive.css"></head><body>
<nav class="topbar"><a href="/dashboard">My Drive</a><span>File details</span><a href="/dashboard/log-out">Log out</a></nav>
<main class="container"><h1><%= file.name %></h1><dl><dt>Size</dt><dd><%= (file.size / 1024).toFixed(1) %> KB</dd><dt>Type</dt><dd><%= file.mimetype %></dd><dt>Uploaded</dt><dd><%= file.createdAt.toLocaleString() %></dd></dl>
<a class="button" href="/dashboard/file/<%= file.id %>/download">Download</a>
<form class="inline" action="/dashboard/file/<%= file.id %>/delete" method="POST" onsubmit="return confirm('Delete this file?')"><button class="danger">Delete</button></form>
<p><a href="<%= file.folderId ? '/dashboard/folder/' + file.folderId : '/dashboard' %>">Back</a></p></main></body></html>
