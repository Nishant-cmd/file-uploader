<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Folder shared</title><link rel="stylesheet" href="/css/base.css"><link rel="stylesheet" href="/css/drive.css"></head><body><main class="container"><h1>Folder share link</h1><p>Anyone with this link can view and download the folder contents until it expires.</p><input class="share-link" readonly value="<%= shareUrl %>" onclick="this.select()"><p><a href="<%= shareUrl %>">Open shared folder</a></p><p><a href="/dashboard/folder/<%= folderId %>">Back to folder</a></p></main></body></html>
