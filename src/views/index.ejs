<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>File Uploader</title>
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/landing.css" />
  </head>
  <body>
    <%- include('nav/nav') %>

    <main class="landing">
      <section class="hero" aria-labelledby="main-heading">
        <p class="eyebrow">YOUR PERSONAL FILE SPACE</p>
        <h1 id="main-heading">Your Files, Securely Stored. Always Within Reach.</h1>

        <p>
          Upload, organize, and access your important files from anywhere. Keep everything safe, simple, and accessible.
        </p>

        <nav class="hero-actions" aria-label="Account actions">
          <a class="button" href="/auth/sign-up">Get Started</a>
          <a class="button button-secondary" href="/auth/log-in">Log In</a>
        </nav>
      </section>

      <section class="features" aria-label="File storage features">
        <article>
          <h2>Private & Secure</h2>
          <p>Your files stay protected with secure storage and reliable data protection.</p>
        </article>

        <article>
          <h2>Effortless File Uploads</h2>
          <p>Upload your documents, images, and other files quickly.</p>
        </article>

        <article>
          <h2>Access Anytime, Anywhere</h2>
          <p>Access your stored files whenever you need them, from any device with an internet connection.</p>
        </article>
      </section>
    </main>
  </body>
</html>